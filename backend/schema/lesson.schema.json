{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 30,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "Actor",
      "type": "object"
    },
    "Annotation": {
      "additionalProperties": false,
      "properties": {
        "anchor": {
          "description": "A part id of the scene's widget; the note is drawn next to it.",
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Anchor",
          "type": "string"
        },
        "text": {
          "description": "Plain text; may print {fact:name} or {stateKey}.",
          "maxLength": 60,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "anchor",
        "text"
      ],
      "title": "Annotation",
      "type": "object"
    },
    "Axis": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "maxLength": 30,
          "title": "Label",
          "type": "string"
        },
        "min": {
          "title": "Min",
          "type": "number"
        },
        "max": {
          "title": "Max",
          "type": "number"
        }
      },
      "required": [
        "label",
        "min",
        "max"
      ],
      "title": "Axis",
      "type": "object"
    },
    "Card": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "title": "Title",
          "type": "string"
        },
        "body": {
          "title": "Body",
          "type": "string"
        },
        "tag": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tag"
        }
      },
      "required": [
        "title",
        "body",
        "tag"
      ],
      "title": "Card",
      "type": "object"
    },
    "Cards": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "cards",
          "title": "Type",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/Card"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Items",
          "type": "array"
        },
        "covers": {
          "items": {
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
            "type": "string"
          },
          "title": "Covers",
          "type": "array"
        }
      },
      "required": [
        "type",
        "items",
        "covers"
      ],
      "title": "Cards",
      "type": "object"
    },
    "Column": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 30,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title"
      ],
      "title": "Column",
      "type": "object"
    },
    "CompareProps": {
      "additionalProperties": false,
      "properties": {
        "columns": {
          "items": {
            "$ref": "#/$defs/Column"
          },
          "maxItems": 4,
          "minItems": 2,
          "title": "Columns",
          "type": "array"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/Row"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Rows",
          "type": "array"
        }
      },
      "required": [
        "columns",
        "rows"
      ],
      "title": "CompareProps",
      "type": "object"
    },
    "CompareVisual": {
      "additionalProperties": false,
      "properties": {
        "widget": {
          "const": "Compare",
          "title": "Widget",
          "type": "string"
        },
        "props": {
          "$ref": "#/$defs/CompareProps"
        }
      },
      "required": [
        "widget",
        "props"
      ],
      "title": "CompareVisual",
      "type": "object"
    },
    "ConfusionRecipe": {
      "additionalProperties": false,
      "properties": {
        "recipe": {
          "const": "confusion",
          "title": "Recipe",
          "type": "string"
        },
        "classes": {
          "items": {
            "type": "string"
          },
          "maxItems": 6,
          "minItems": 2,
          "title": "Classes",
          "type": "array"
        },
        "actual": {
          "description": "Class index per example.",
          "items": {
            "type": "integer"
          },
          "maxItems": 200,
          "minItems": 1,
          "title": "Actual",
          "type": "array"
        },
        "predicted": {
          "description": "Class index per example.",
          "items": {
            "type": "integer"
          },
          "maxItems": 200,
          "minItems": 1,
          "title": "Predicted",
          "type": "array"
        }
      },
      "required": [
        "recipe",
        "classes",
        "actual",
        "predicted"
      ],
      "title": "ConfusionRecipe",
      "type": "object"
    },
    "Dataset": {
      "additionalProperties": false,
      "properties": {
        "shape": {
          "description": "blobs/moons/circles/xor are labelled classes; line/curve are regression data (classes 1).",
          "enum": [
            "blobs",
            "moons",
            "circles",
            "xor",
            "line",
            "curve"
          ],
          "title": "Shape",
          "type": "string"
        },
        "n": {
          "description": "Number of points; a random quarter of them is held out as test data.",
          "maximum": 200,
          "minimum": 20,
          "title": "N",
          "type": "integer"
        },
        "noise": {
          "maximum": 1,
          "minimum": 0,
          "title": "Noise",
          "type": "number"
        },
        "classes": {
          "description": "1 for line/curve; 2 for moons/circles/xor; 2 or 3 for blobs.",
          "maximum": 3,
          "minimum": 1,
          "title": "Classes",
          "type": "integer"
        },
        "seed": {
          "description": "Same seed, same points, for every learner.",
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        }
      },
      "required": [
        "shape",
        "n",
        "noise",
        "classes",
        "seed"
      ],
      "title": "Dataset",
      "type": "object"
    },
    "DiagramProps": {
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "items": {
            "$ref": "#/$defs/Node"
          },
          "maxItems": 12,
          "minItems": 2,
          "title": "Nodes",
          "type": "array"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/Edge"
          },
          "maxItems": 20,
          "title": "Edges",
          "type": "array"
        },
        "groups": {
          "items": {
            "$ref": "#/$defs/Group"
          },
          "maxItems": 4,
          "title": "Groups",
          "type": "array"
        }
      },
      "required": [
        "nodes",
        "edges",
        "groups"
      ],
      "title": "DiagramProps",
      "type": "object"
    },
    "DiagramVisual": {
      "additionalProperties": false,
      "properties": {
        "widget": {
          "const": "Diagram",
          "title": "Widget",
          "type": "string"
        },
        "props": {
          "$ref": "#/$defs/DiagramProps"
        }
      },
      "required": [
        "widget",
        "props"
      ],
      "title": "DiagramVisual",
      "type": "object"
    },
    "DistributionProps": {
      "additionalProperties": false,
      "properties": {
        "labels": {
          "description": "One per option, e.g. candidate next tokens.",
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "minItems": 2,
          "title": "Labels",
          "type": "array"
        },
        "logits": {
          "description": "Illustrative raw scores, one per label. The browser computes probabilities.",
          "items": {
            "type": "number"
          },
          "title": "Logits",
          "type": "array"
        },
        "target": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Index of the correct label, for cross-entropy. Optional.",
          "title": "Target"
        }
      },
      "required": [
        "labels",
        "logits",
        "target"
      ],
      "title": "DistributionProps",
      "type": "object"
    },
    "DistributionVisual": {
      "additionalProperties": false,
      "properties": {
        "widget": {
          "const": "Distribution",
          "title": "Widget",
          "type": "string"
        },
        "props": {
          "$ref": "#/$defs/DistributionProps"
        }
      },
      "required": [
        "widget",
        "props"
      ],
      "title": "DistributionVisual",
      "type": "object"
    },
    "DotProductRecipe": {
      "additionalProperties": false,
      "properties": {
        "recipe": {
          "const": "dot-product",
          "title": "Recipe",
          "type": "string"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/Vector"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Rows",
          "type": "array"
        },
        "cols": {
          "items": {
            "$ref": "#/$defs/Vector"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Cols",
          "type": "array"
        }
      },
      "required": [
        "recipe",
        "rows",
        "cols"
      ],
      "title": "DotProductRecipe",
      "type": "object"
    },
    "Edge": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "from": {
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "From",
          "type": "string"
        },
        "to": {
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "To",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        }
      },
      "required": [
        "id",
        "from",
        "to",
        "label"
      ],
      "title": "Edge",
      "type": "object"
    },
    "ExploreScene": {
      "additionalProperties": false,
      "properties": {
        "layout": {
          "const": "explore",
          "title": "Layout",
          "type": "string"
        },
        "id": {
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "visual": {
          "discriminator": {
            "mapping": {
              "Compare": "#/$defs/CompareVisual",
              "Diagram": "#/$defs/DiagramVisual",
              "Distribution": "#/$defs/DistributionVisual",
              "FunctionPlot": "#/$defs/FunctionPlotVisual",
              "Matrix": "#/$defs/MatrixVisual",
              "PointCloud": "#/$defs/PointCloudVisual",
              "Sequence": "#/$defs/SequenceVisual"
            },
            "propertyName": "widget"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/DiagramVisual"
            },
            {
              "$ref": "#/$defs/SequenceVisual"
            },
            {
              "$ref": "#/$defs/CompareVisual"
            },
            {
              "$ref": "#/$defs/FunctionPlotVisual"
            },
            {
              "$ref": "#/$defs/MatrixVisual"
            },
            {
              "$ref": "#/$defs/DistributionVisual"
            },
            {
              "$ref": "#/$defs/PointCloudVisual"
            }
          ],
          "title": "Visual"
        },
        "state": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "description": "Default value for every state key the widget reads.",
          "title": "State",
          "type": "object"
        },
        "controls": {
          "items": {
            "discriminator": {
              "mapping": {
                "select": "#/$defs/Select",
                "slider": "#/$defs/Slider"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/Slider"
              },
              {
                "$ref": "#/$defs/Select"
              }
            ]
          },
          "title": "Controls",
          "type": "array"
        },
        "task": {
          "title": "Task",
          "type": "string"
        }
      },
      "required": [
        "layout",
        "id",
        "title",
        "visual",
        "state",
        "controls",
        "task"
      ],
      "title": "ExploreScene",
      "type": "object"
    },
    "FunctionPlotProps": {
      "additionalProperties": false,
      "properties": {
        "expression": {
          "description": "y as a function of x and the parameters, e.g. 'a * x^2 + b'.",
          "maxLength": 200,
          "title": "Expression",
          "type": "string"
        },
        "x": {
          "$ref": "#/$defs/Axis"
        },
        "y": {
          "anyOf": [
            {
              "$ref": "#/$defs/Axis"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Omit to fit the y axis to the curve."
        },
        "params": {
          "items": {
            "$ref": "#/$defs/Param"
          },
          "maxItems": 4,
          "title": "Params",
          "type": "array"
        }
      },
      "required": [
        "expression",
        "x",
        "y",
        "params"
      ],
      "title": "FunctionPlotProps",
      "type": "object"
    },
    "FunctionPlotVisual": {
      "additionalProperties": false,
      "properties": {
        "widget": {
          "const": "FunctionPlot",
          "title": "Widget",
          "type": "string"
        },
        "props": {
          "$ref": "#/$defs/FunctionPlotProps"
        }
      },
      "required": [
        "widget",
        "props"
      ],
      "title": "FunctionPlotVisual",
      "type": "object"
    },
    "Group": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 40,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "Group",
      "type": "object"
    },
    "KeyPoint": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "sources": {
          "description": "Source ids; required when the lesson is time-sensitive.",
          "items": {
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "id",
        "text",
        "sources"
      ],
      "title": "KeyPoint",
      "type": "object"
    },
    "MatrixVisual": {
      "additionalProperties": false,
      "properties": {
        "widget": {
          "const": "Matrix",
          "title": "Widget",
          "type": "string"
        },
        "props": {
          "discriminator": {
            "mapping": {
              "confusion": "#/$defs/ConfusionRecipe",
              "dot-product": "#/$defs/DotProductRecipe",
              "softmax": "#/$defs/SoftmaxRecipe"
            },
            "propertyName": "recipe"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/SoftmaxRecipe"
            },
            {
              "$ref": "#/$defs/DotProductRecipe"
            },
            {
              "$ref": "#/$defs/ConfusionRecipe"
            }
          ],
          "title": "Props"
        }
      },
      "required": [
        "widget",
        "props"
      ],
      "title": "MatrixVisual",
      "type": "object"
    },
    "Message": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "from": {
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "From",
          "type": "string"
        },
        "to": {
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "To",
          "type": "string"
        },
        "text": {
          "maxLength": 80,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "from",
        "to",
        "text"
      ],
      "title": "Message",
      "type": "object"
    },
    "Misconception": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "Misconception",
      "type": "object"
    },
    "Node": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 40,
          "title": "Label",
          "type": "string"
        },
        "group": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group"
        }
      },
      "required": [
        "id",
        "label",
        "group"
      ],
      "title": "Node",
      "type": "object"
    },
    "Param": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "An identifier other than x.",
          "pattern": "^[a-wyz][A-Za-z0-9]*$",
          "title": "Name",
          "type": "string"
        },
        "label": {
          "maxLength": 30,
          "title": "Label",
          "type": "string"
        },
        "min": {
          "title": "Min",
          "type": "number"
        },
        "max": {
          "title": "Max",
          "type": "number"
        }
      },
      "required": [
        "name",
        "label",
        "min",
        "max"
      ],
      "title": "Param",
      "type": "object"
    },
    "PointCloudProps": {
      "additionalProperties": false,
      "properties": {
        "dataset": {
          "$ref": "#/$defs/Dataset"
        },
        "xLabel": {
          "maxLength": 30,
          "title": "Xlabel",
          "type": "string"
        },
        "yLabel": {
          "maxLength": 30,
          "title": "Ylabel",
          "type": "string"
        },
        "classLabels": {
          "description": "One short name per class, e.g. ['spam', 'not spam'].",
          "items": {
            "type": "string"
          },
          "title": "Classlabels",
          "type": "array"
        },
        "model": {
          "enum": [
            "none",
            "linear",
            "polynomial",
            "logistic",
            "knn",
            "kmeans"
          ],
          "title": "Model",
          "type": "string"
        }
      },
      "required": [
        "dataset",
        "xLabel",
        "yLabel",
        "classLabels",
        "model"
      ],
      "title": "PointCloudProps",
      "type": "object"
    },
    "PointCloudVisual": {
      "additionalProperties": false,
      "properties": {
        "widget": {
          "const": "PointCloud",
          "title": "Widget",
          "type": "string"
        },
        "props": {
          "$ref": "#/$defs/PointCloudProps"
        }
      },
      "required": [
        "widget",
        "props"
      ],
      "title": "PointCloudVisual",
      "type": "object"
    },
    "Predict": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "predict",
          "title": "Type",
          "type": "string"
        },
        "question": {
          "title": "Question",
          "type": "string"
        },
        "options": {
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 2,
          "title": "Options",
          "type": "array"
        },
        "answer": {
          "description": "Index into options.",
          "title": "Answer",
          "type": "integer"
        },
        "hint": {
          "title": "Hint",
          "type": "string"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "misconception": {
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Misconception",
          "type": "string"
        },
        "covers": {
          "items": {
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
            "type": "string"
          },
          "title": "Covers",
          "type": "array"
        }
      },
      "required": [
        "type",
        "question",
        "options",
        "answer",
        "hint",
        "explanation",
        "misconception",
        "covers"
      ],
      "title": "Predict",
      "type": "object"
    },
    "Prose": {
